# Server-only Django backend connection
# Never use NEXT_PUBLIC_ for backend URLs or credentials.
# Local development: run the Django backend on this port.
# For production, configure BACKEND_API_URL in your hosting provider to
# your ACTUAL, publicly reachable HTTPS Django API host (not localhost).
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
BACKEND_SIGNUP_PATH=/auth/signup

# Set after deploying to your real HTTPS domain
# SITE_URL=https://your-domain.example

# Optional: enables a working email action on the contact page
# CONTACT_EMAIL=hello@your-domain.example
